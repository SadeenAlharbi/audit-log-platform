# Copy to .env (bin/setup does it) and change every password before production.

APP_NAME="Audit Log Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

# Docker build target: dev (source bind-mounted) or prod (baked image)
APP_BUILD_TARGET=dev
APP_IMAGE_TAG=dev

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- MariaDB -------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=audit_log
DB_USERNAME=audit_app
DB_PASSWORD=change-me-app
DB_ROOT_PASSWORD=change-me-root
DB_TEST_DATABASE=audit_testing
# Port exposed on 127.0.0.1 of the host (for TablePlus / DBeaver)
FORWARD_DB_PORT=33060

# The only DB account the triggers allow to DELETE from audit_logs (D3).
DB_ARCHIVER_USERNAME=audit_archiver
DB_ARCHIVER_PASSWORD=change-me-archiver

# Least-privilege account for mariadb-backup (D5).
DB_BACKUP_USERNAME=audit_backup
DB_BACKUP_PASSWORD=change-me-backup
BACKUP_FULL_HOUR=2

# --- Redis (queues, cache, sessions, rate limiting) ----------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Audit platform -------------------------------------------------------
# Platform-wide ceiling for any project's retention_days (D3). Monthly
# partitions entirely older than this are archived then dropped.
AUDIT_MAX_RETENTION_DAYS=395
AUDIT_DEFAULT_RETENTION_DAYS=365
# Monthly partitions kept ready ahead of time / created behind "now".
AUDIT_PARTITIONS_AHEAD=3
AUDIT_PARTITIONS_BACKFILL=1
# InnoDB page compression on audit_logs (plan §2).
AUDIT_PAGE_COMPRESSION=true

# Initial Super Admin created by the seeder (only if both are set).
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="audit@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Off-site storage for archives & backups (weeks 4) --------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
