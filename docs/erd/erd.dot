R="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="finished_at_in"></TD><TD ALIGN="LEFT">finished_at</TD><TD ALIGN="LEFT" PORT="finished_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="error_in"></TD><TD ALIGN="LEFT">error</TD><TD ALIGN="LEFT" PORT="error_out"><FONT COLOR="#6b7280" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="updated_at_in"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR></TABLE>>];
        "saml2_tenants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#4b5563" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4b5563" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>saml2_tenants</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="id_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">int</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="uuid_in"><FONT COLOR="#6b7280" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT" PORT="uuid_out"><FONT COLOR="#6b7280" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="key_in"></TD><TD ALIGN="LEFT">key</TD><TD ALIGN="LEFT" PORT="key_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="idp_entity_id_in"></TD><TD ALIGN="LEFT">idp_entity_id</TD><TD ALIGN="LEFT" PORT="idp_entity_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="idp_login_url_in"></TD><TD ALIGN="LEFT">idp_login_url</TD><TD ALIGN="LEFT" PORT="idp_login_url_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="idp_logout_url_in"></TD><TD ALIGN="LEFT">idp_logout_url</TD><TD ALIGN="LEFT" PORT="idp_logout_url_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="idp_x509_cert_in"></TD><TD ALIGN="LEFT">idp_x509_cert</TD><TD ALIGN="LEFT" PORT="idp_x509_cert_out"><FONT COLOR="#6b7280" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="relay_state_url_in"></TD><TD ALIGN="LEFT">relay_state_url</TD><TD ALIGN="LEFT" PORT="relay_state_url_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="name_id_format_in"></TD><TD ALIGN="LEFT">name_id_format</TD><TD ALIGN="LEFT" PORT="name_id_format_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="metadata_in"></TD><TD ALIGN="LEFT">metadata</TD><TD ALIGN="LEFT" PORT="metadata_out"><FONT COLOR="#6b7280" POINT-SIZE="9">json</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="updated_at_in"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="deleted_at_in"></TD><TD ALIGN="LEFT">deleted_at</TD><TD ALIGN="LEFT" PORT="deleted_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR></TABLE>>];
        "password_reset_tokens" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#4b5563" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4b5563" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>password_reset_tokens</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="email_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>email</B></TD><TD ALIGN="LEFT" PORT="email_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="token_in"></TD><TD ALIGN="LEFT">token</TD><TD ALIGN="LEFT" PORT="token_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR></TABLE>>];
        "failed_jobs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#4b5563" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#4b5563" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>failed_jobs</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="id_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="uuid_in"><FONT COLOR="#6b7280" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT" PORT="uuid_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="connection_in"></TD><TD ALIGN="LEFT">connection</TD><TD ALIGN="LEFT" PORT="connection_out"><FONT COLOR="#6b7280" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="queue_in"></TD><TD ALIGN="LEFT">queue</TD><TD ALIGN="LEFT" PORT="queue_out"><FONT COLOR="#6b7280" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="payload_in"></TD><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT" PORT="payload_out"><FONT COLOR="#6b7280" POINT-SIZE="9">longtext</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="exception_in"></TD><TD ALIGN="LEFT">exception</TD><TD ALIGN="LEFT" PORT="exception_out"><FONT COLOR="#6b7280" POINT-SIZE="9">longtext</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="failed_at_in"></TD><TD ALIGN="LEFT">failed_at</TD><TD ALIGN="LEFT" PORT="failed_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR></TABLE>>];
    }
    "project_api_keys":"id_out":e -> "ingestion_batches":"api_key_id_in":w;
