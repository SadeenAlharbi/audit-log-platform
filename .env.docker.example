# Audit Log Hub - environment for the Docker stack.
# bin/setup copies this file to .env and replaces every "change-me-*" value
# with a random secret. Never commit .env.

APP_NAME="Audit Log Hub"
# Shown in the dashboard footer, e.g. "جامعة القصيم" (optional).
AUDIT_ORGANIZATION_NAME=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
# Arabic dashboard (RTL); the API always answers in English.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Docker build target: dev (source bind-mounted) or prod (baked image)
APP_BUILD_TARGET=dev
APP_IMAGE_TAG=dev

# Behind a TLS-terminating proxy / load balancer: its IPs (or "*").
TRUSTED_PROXIES=

# --- Logging (plan §11): one JSON object per line on stderr -----------------
LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug

# --- MariaDB ---------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=audit_log
DB_USERNAME=audit_app
DB_PASSWORD=change-me-app
# Migrations and partition maintenance (ALTER/DROP/TRIGGER). The runtime
# account above has SELECT/INSERT/UPDATE/DELETE only.
DB_MAINTENANCE_USERNAME=audit_maintenance
DB_MAINTENANCE_PASSWORD=change-me-maintenance
DB_ROOT_PASSWORD=change-me-root
DB_TEST_DATABASE=audit_testing
# Port exposed on 127.0.0.1 of the host (TablePlus / DBeaver)
FORWARD_DB_PORT=33060

# The only DB account the triggers allow to DELETE from audit_logs (D3).
DB_ARCHIVER_USERNAME=audit_archiver
DB_ARCHIVER_PASSWORD=change-me-archiver

# Least-privilege account for mariadb-backup (D5).
DB_BACKUP_USERNAME=audit_backup
DB_BACKUP_PASSWORD=change-me-backup

# --- Redis (queues, cache, sessions, rate limiting) -------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# Dashboard sessions end after 30 idle minutes (plan §13).
SESSION_LIFETIME=30
# true in production (HTTPS only cookies, docs/runbook.md §1.2).
SESSION_SECURE_COOKIE=false
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Audit platform -----------------------------------------------------------
# Platform-wide ceiling for any project's retention_days (D3).
AUDIT_MAX_RETENTION_DAYS=395
AUDIT_DEFAULT_RETENTION_DAYS=365
AUDIT_PARTITIONS_AHEAD=3
AUDIT_PARTITIONS_BACKFILL=13
AUDIT_PAGE_COMPRESSION=true

# API (plan §6/§7). HTTPS is enforced automatically when APP_ENV=production;
# set AUDIT_API_REQUIRE_HTTPS=false only on a local machine without TLS.
AUDIT_API_RATE_LIMIT=1000
AUDIT_API_KEY_LIFETIME_DAYS=90
# AUDIT_API_REQUIRE_HTTPS=
# AUDIT_API_IP_RATE_LIMIT=3000
# AUDIT_API_KEY_ROTATION_GRACE_HOURS=24
# AUDIT_API_MAX_BATCH=500
# AUDIT_API_MAX_PAYLOAD=1048576
# AUDIT_API_MAX_FUTURE_SKEW=300
# AUDIT_API_SIGNATURE_TOLERANCE=300
# AUDIT_INGEST_QUEUE=ingest

# Archive, retention and rejected-request log (defaults shown).
# AUDIT_ARCHIVE_DISK=archive
# AUDIT_ARCHIVE_GRACE_DAYS=7
# AUDIT_RESTORE_HOLD_DAYS=30
# AUDIT_PRUNE_BATCH_SIZE=5000
# AUDIT_SECURITY_ALERT_THRESHOLD=20
# AUDIT_SECURITY_MAX_EVENTS_PER_MINUTE=30
# AUDIT_SECURITY_EVENTS_RETENTION_DAYS=365
# BACKUP_DISK=backups
# BACKUP_SPOOL_PATH=
# BACKUP_ENV_FILE=
# DB_MAINTENANCE_CONNECTION=maintenance

# Initial Super Admin created by the seeder (only if both are set).
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SAML single sign-on for the dashboard (decision D15), alongside the password.
# Only existing accounts can sign in (matched by e-mail), and 2FA is still asked.
# Development: set SAML2_ENABLED=true, then `make sso` (starts Keycloak and
# configures it; demo users *@demo.test / Demo-SSO-2026!, after `make demo`).
# Production: point SAML2_IDP_METADATA_URL at the company IdP (or set the
# explicit values), then `php artisan audit:saml-sync`. The IdP needs:
#   SP entity id  = APP_URL/saml2/<SAML2_TENANT_UUID>/metadata
#   ACS (POST)    = APP_URL/saml2/<SAML2_TENANT_UUID>/acs
#   NameID        = the user's e-mail (or an "email" attribute), assertions signed
SAML2_ENABLED=false
SAML2_TENANT_UUID=6f1c2c5e-4b7a-4d2e-9a51-0c8e3f2b7d10
SAML2_IDP_METADATA_URL=http://keycloak:8080/realms/audit/protocol/saml/descriptor
# SAML2_IDP_ENTITY_ID=
# SAML2_IDP_LOGIN_URL=
# SAML2_IDP_LOGOUT_URL=
# SAML2_IDP_X509_CERT=
# SAML2_BUTTON_LABEL=الدخول الموحد
# SAML2_EMAIL_ATTRIBUTE=email
# SAML2_PROXY_VARS=false

# --- Alerts (plan §11): failed backups, queue backlog, repeated rejections --
ALERT_MAIL_TO=
ALERT_SLACK_WEBHOOK_URL=
ALERT_QUEUE_BACKLOG=5000

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="audit@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Off-site storage (plan §9/§12) -----------------------------------------
# Development: archive and backups stay on local disk (storage/app/archive,
# storage/app/backups and the "backups" volume). Production: set the drivers
# to s3, fill the AWS_* values with a real off-server bucket and set
# BACKUP_RCLONE_REMOTE=offsite:<bucket> (see docs/runbook.md §1).
# In development BACKUP_RCLONE_REMOTE=/offsite ships the encrypted backups to a
# separate Docker volume that stands in for the off-site storage, so the full
# path (upload, byte-for-byte check, `make offsite-drill`) works for free.
# Never use /offsite in production: it is on the same server.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BUCKET=audit-archive

# Write-ahead + monthly JSONL.gz archive of audit_logs.
AUDIT_ARCHIVE_DRIVER=local
AUDIT_ARCHIVE_BUCKET=audit-archive

# Application-file backups (backup:run) and database backups (backup container).
BACKUP_DRIVER=local
BACKUP_BUCKET=audit-backups
# rclone remote used by the backup container (empty = keep backups local only).
BACKUP_RCLONE_REMOTE=/offsite
BACKUP_S3_PROVIDER=AWS
# age public key: every backup is encrypted with it before it leaves the
# server. bin/setup generates a key pair and stores the PRIVATE key in
# secrets/backup-age-identity.txt - move that file to a safe place OFF the
# server (password manager / vault) and delete it from the server.
BACKUP_AGE_RECIPIENT=
BACKUP_FULL_HOUR=2
# 1 = Monday ... 7 = Sunday
BACKUP_RESTORE_TEST_WEEKDAY=5

# --- Development tools --------------------------------------------------------
# Laravel Telescope at /telescope (local only, stored in storage/telescope).
TELESCOPE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
