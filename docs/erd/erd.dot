    "ingestion_batches":"id_out":e -> "audit_logs":"batch_id_in":w [style=dashed, color="#6b7280", arrowhead=crowodot];
    "audit_logs":"uid_out":e -> "ingestion_keys":"log_uid_in":w [style=dashed, color="#6b7280", arrowhead=teeodot];
    "users":"id_out":e -> "model_has_roles":"model_id_in":w [style=dashed, color="#6b7280", arrowhead=crowodot];
    "users":"id_out":e -> "model_has_permissions":"model_id_in":w [style=dashed, color="#6b7280", arrowhead=crowodot];
