#!/usr/bin/env bash
# Writes the reference schema (plan §4 / §15) to database/schema/schema.sql:
# tables, partitions and triggers, without data and without AUTO_INCREMENT
# counters, so the file only changes when the schema really changes.
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p database/schema
out=database/schema/schema.sql

docker compose exec -T mariadb sh -c \
    'mariadb-dump --no-data --triggers --routines --skip-comments --skip-dump-date \
        -uroot -p"$MARIADB_ROOT_PASSWORD" "$MARIADB_DATABASE"' \
    | sed -E 's/ AUTO_INCREMENT=[0-9]+//; s#/\*!50017 DEFINER=`[^`]+`@`[^`]+`\*/ ##; /enable the sandbox mode/d' > "$out.tmp"

{
    echo "-- Audit Log Hub - reference schema (plan §4/§15), generated by bin/schema-dump"
    echo "-- from the migrations on MariaDB 11.8. Partition list reflects the generation"
    echo "-- date with AUDIT_PARTITIONS_BACKFILL=$(grep -E '^AUDIT_PARTITIONS_BACKFILL=' .env | cut -d= -f2) (decision D11)."
    echo
    cat "$out.tmp"
} > "$out" && rm -f "$out.tmp"

echo "Schema written to $out"
