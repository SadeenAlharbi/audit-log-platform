#!/usr/bin/env bash
# Runs every check of the project (non-destructive) and saves the full output to
# storage/logs/doctor.log, so problems can be diagnosed from one file.
#
#   ./bin/doctor
set -uo pipefail
cd "$(dirname "$0")/.."

LOG=storage/logs/doctor.log
mkdir -p storage/logs
: > "$LOG"

step() {
    local title="$1"; shift
    echo "" | tee -a "$LOG"
    echo "==================== $title ====================" | tee -a "$LOG"
    echo "\$ $*" >> "$LOG"
    "$@" 2>&1 | tee -a "$LOG"
    local code=${PIPESTATUS[0]}
    echo "[exit code: $code]" | tee -a "$LOG"
    return 0
}

{
    echo "doctor run: $(date -u +%FT%TZ)"
    echo "git: $(git log --oneline -1 2>/dev/null)"
    docker version --format 'docker client {{.Client.Version}} / server {{.Server.Version}}' 2>&1
    docker compose version 2>&1
} | tee -a "$LOG"

if [ ! -f .env ]; then
    # bin/setup generates the passwords and the backup key; a copied example
    # would start MariaDB with the "change-me" placeholders.
    echo "no .env yet: run bin/setup (or make setup) first" | tee -a "$LOG"
    exit 1
fi

if [ ! -f vendor/autoload.php ]; then
    step "composer install" docker compose run --rm --no-deps --entrypoint composer app install --no-interaction --prefer-dist
fi

step "build" docker compose build
step "up" docker compose up -d
for _ in $(seq 1 75); do [ "$(docker inspect -f '{{.State.Health.Status}}' "$(docker compose ps -q app)" 2>/dev/null)" = healthy ] && break; sleep 4; done
step "status" docker compose ps -a

if ! grep -qE '^APP_KEY=.+' .env; then
    step "key:generate" docker compose exec -T app php artisan key:generate --force
fi

step "runtime DB grants (must not include ALTER/DROP/TRIGGER on the app database)" docker compose exec -T mariadb sh -c 'mariadb -uroot -p"$MARIADB_ROOT_PASSWORD" -e "SHOW GRANTS FOR \`$DB_USERNAME\`@\`%\`"'
clock_check() {
    # 2FA codes are time-based: a container clock that drifted (Docker Desktop
    # after the Mac sleeps) makes every correct code fail.
    local host app diff
    host=$(date -u +%s)
    app=$(docker compose exec -T app date -u +%s 2>/dev/null | tr -d '\r')
    diff=$(( app - host )); diff=${diff#-}
    echo "host $(date -u +%T) UTC, app container $(date -u -r "$app" +%T 2>/dev/null || date -u -d "@$app" +%T) UTC, difference ${diff}s"
    if [ "$diff" -gt 30 ]; then
        echo "WARNING: the container clock is off by ${diff}s. 2FA codes will be refused. Restart Docker Desktop, then run ./bin/doctor again."
        return 1
    fi
    echo "OK"
}
step "clock (2FA needs the container clock in sync)" clock_check
offsite_check() {
    local env remote
    env=$(grep -E '^APP_ENV=' .env | cut -d= -f2)
    remote=$(grep -E '^BACKUP_RCLONE_REMOTE=' .env | cut -d= -f2)
    echo "APP_ENV=$env BACKUP_RCLONE_REMOTE=${remote:-<empty>}"
    if [ "$env" = production ] && { [ -z "$remote" ] || [ "${remote#/}" != "$remote" ]; }; then
        echo "WARNING: production backups must go to a real off-site remote (offsite:<bucket>), not a local path."
        return 1
    fi
    echo "OK"
}
step "off-site backup target" offsite_check
step "about" docker compose exec -T app php artisan about --only=environment,drivers
step "migrate --seed" docker compose exec -T app php artisan migrate --seed --force
step "partitions" docker compose exec -T app php artisan audit:partitions
step "tests" docker compose exec -T app php artisan test
step "pint" docker compose exec -T app ./vendor/bin/pint --test
step "phpstan" docker compose exec -T app ./vendor/bin/phpstan analyse --memory-limit=1G --no-progress --error-format=raw
step "http /" curl -s -o /dev/null -w "%{http_code}\n" "http://localhost:$(grep -E '^APP_PORT=' .env | cut -d= -f2)/"

step "app logs" docker compose logs --tail=80 app
step "queue-worker logs" docker compose logs --tail=40 queue-worker
step "scheduler logs" docker compose logs --tail=40 scheduler
step "mariadb logs" docker compose logs --tail=60 mariadb

echo ""
echo "Full report saved to $LOG"
