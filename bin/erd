#!/usr/bin/env python3
"""Generate the ERD from database/schema/schema.sql.

Writes docs/erd/erd.mmd (Mermaid source). With the Mermaid CLI (mmdc) on the
PATH it also renders docs/erd/erd.svg and docs/erd/erd.pdf.

    ./bin/erd            # after `make schema-dump`

Solid lines are foreign keys. Dotted lines are logical references without a
foreign key: audit_logs is partitioned, and MariaDB does not allow foreign
keys on partitioned tables (decision D1); spatie's model_has_* tables are
polymorphic.
"""

import pathlib
import re
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SCHEMA = ROOT / "database/schema/schema.sql"
OUT = ROOT / "docs/erd"

SKIP = {"migrations"}

# Logical references (no FK): (parent, child, label, one-to-one?)
LOGICAL = [
    ("projects", "audit_logs", "project_id (no FK)", False),
    ("project_api_keys", "audit_logs", "api_key_id (no FK)", False),
    ("ingestion_batches", "audit_logs", "batch_id (no FK)", False),
    ("ingestion_keys", "audit_logs", "log_uid = uid", True),
    ("users", "model_has_roles", "model_id (polymorphic)", False),
    ("users", "model_has_permissions", "model_id (polymorphic)", False),
]


def parse(sql: str):
    tables = {}
    for name, body in re.findall(r"CREATE TABLE `(\w+)` \((.*?)\n\)", sql, re.S):
        if name in SKIP:
            continue
        cols = []
        for col, ctype, rest in re.findall(r"^\s+`(\w+)` (\w+)(.*)$", body, re.M):
            # MariaDB stores JSON as LONGTEXT with a json_valid() check.
            ctype = "json" if "json_valid(" in rest else ctype.lower()
            cols.append([col, ctype, set()])
        pk = re.search(r"PRIMARY KEY \(([^)]*)\)", body)
        pk_cols = re.findall(r"`(\w+)`", pk.group(1)) if pk else []
        uniques = [re.findall(r"`(\w+)`", u) for u in re.findall(r"UNIQUE KEY `\w+` \(([^)]*)\)", body)]
        fks = re.findall(r"FOREIGN KEY \(`(\w+)`\) REFERENCES `(\w+)`", body)
        fk_cols = {c for c, _ in fks}
        for c in cols:
            if c[0] in pk_cols:
                c[2].add("PK")
            if c[0] in fk_cols:
                c[2].add("FK")
            if any(u == [c[0]] for u in uniques):
                c[2].add("UK")
        tables[name] = {"cols": cols, "fks": fks}
    return tables


def mermaid(tables) -> str:
    lines = ["erDiagram"]
    for name, t in tables.items():
        lines.append(f"    {name} {{")
        for col, ctype, keys in t["cols"]:
            k = ",".join(x for x in ("PK", "FK", "UK") if x in keys)
            lines.append(f"        {ctype} {col}{' ' + k if k else ''}")
        lines.append("    }")
    seen = set()
    for child, t in tables.items():
        for col, parent in t["fks"]:
            if (parent, child, col) in seen:
                continue
            seen.add((parent, child, col))
            lines.append(f'    {parent} ||--o{{ {child} : "{col}"')
    for parent, child, label, one in LOGICAL:
        if parent in tables and child in tables:
            lines.append(f'    {parent} ||..{"||" if one else "o{"} {child} : "{label}"')
    return "\n".join(lines) + "\n"


def main() -> int:
    tables = parse(SCHEMA.read_text())
    OUT.mkdir(parents=True, exist_ok=True)
    src = OUT / "erd.mmd"
    src.write_text(mermaid(tables))
    print(f"{src.relative_to(ROOT)}: {len(tables)} tables")

    mmdc = shutil.which("mmdc")
    if not mmdc:
        print("mmdc not found: install @mermaid-js/mermaid-cli to render SVG/PDF")
        return 0
    for ext in ("svg", "pdf"):
        args = [mmdc, "-i", str(src), "-o", str(OUT / f"erd.{ext}"), "-b", "white", "-w", "2400"]
        if ext == "pdf":
            args.append("--pdfFit")
        subprocess.run(args, check=True)
        print(f"docs/erd/erd.{ext}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
