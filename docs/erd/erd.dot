digraph ERD {
    graph [rankdir=LR, splines=ortho, nodesep=0.35, ranksep=0.9, newrank=true, pad=0.4, bgcolor="white",
           fontname="IBM Plex Sans Arabic,DejaVu Sans,sans-serif", fontsize=22, labelloc=t, labeljust=l,
           label=<<B>Audit Log Hub — ERD</B>>];
    node [shape=plaintext, fontname="IBM Plex Sans Arabic,DejaVu Sans,sans-serif", fontsize=11];
    edge [fontname="IBM Plex Sans Arabic,DejaVu Sans,sans-serif", color="#374151", penwidth=1.3, dir=both, arrowtail=teetee, arrowhead=crowodot, arrowsize=0.8];
    subgraph cluster_ingest {
        label=<<B>Logs and ingestion  ·  السجلات والاستلام</B>>; fontsize=15; fontcolor="#166534"; style="rounded,filled"; color="#166534"; fillcolor="#f0fdf4"; penwidth=1.5; margin=18;
        "projects" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#166534" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#166534" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>projects</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="id_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="name_in"></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="slug_in"><FONT COLOR="#6b7280" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT" PORT="slug_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="description_in"></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="description_out"><FONT COLOR="#6b7280" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="is_active_in"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active_out"><FONT COLOR="#6b7280" POINT-SIZE="9">tinyint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="retention_days_in"></TD><TD ALIGN="LEFT">retention_days</TD><TD ALIGN="LEFT" PORT="retention_days_out"><FONT COLOR="#6b7280" POINT-SIZE="9">smallint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_by_in"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT" PORT="created_by_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT><FONT COLOR="#9ca3af" POINT-SIZE="8">  → users.id</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="archived_at_in"></TD><TD ALIGN="LEFT">archived_at</TD><TD ALIGN="LEFT" PORT="archived_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="archived_by_in"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">archived_by</TD><TD ALIGN="LEFT" PORT="archived_by_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT><FONT COLOR="#9ca3af" POINT-SIZE="8">  → users.id</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="updated_at_in"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR></TABLE>>];
        "project_api_keys" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#166534" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#166534" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>project_api_keys</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="id_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="project_id_in"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT" PORT="project_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="name_in"></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="environment_in"></TD><TD ALIGN="LEFT">environment</TD><TD ALIGN="LEFT" PORT="environment_out"><FONT COLOR="#6b7280" POINT-SIZE="9">enum</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="key_prefix_in"></TD><TD ALIGN="LEFT">key_prefix</TD><TD ALIGN="LEFT" PORT="key_prefix_out"><FONT COLOR="#6b7280" POINT-SIZE="9">char</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="key_hash_in"><FONT COLOR="#6b7280" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">key_hash</TD><TD ALIGN="LEFT" PORT="key_hash_out"><FONT COLOR="#6b7280" POINT-SIZE="9">char</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="hmac_secret_in"></TD><TD ALIGN="LEFT">hmac_secret</TD><TD ALIGN="LEFT" PORT="hmac_secret_out"><FONT COLOR="#6b7280" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="scopes_in"></TD><TD ALIGN="LEFT">scopes</TD><TD ALIGN="LEFT" PORT="scopes_out"><FONT COLOR="#6b7280" POINT-SIZE="9">json</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="allowed_ips_in"></TD><TD ALIGN="LEFT">allowed_ips</TD><TD ALIGN="LEFT" PORT="allowed_ips_out"><FONT COLOR="#6b7280" POINT-SIZE="9">json</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="last_used_at_in"></TD><TD ALIGN="LEFT">last_used_at</TD><TD ALIGN="LEFT" PORT="last_used_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="last_used_ip_in"></TD><TD ALIGN="LEFT">last_used_ip</TD><TD ALIGN="LEFT" PORT="last_used_ip_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="expires_at_in"></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT" PORT="expires_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="revoked_at_in"></TD><TD ALIGN="LEFT">revoked_at</TD><TD ALIGN="LEFT" PORT="revoked_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="revoked_by_in"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">revoked_by</TD><TD ALIGN="LEFT" PORT="revoked_by_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT><FONT COLOR="#9ca3af" POINT-SIZE="8">  → users.id</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_by_in"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT" PORT="created_by_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT><FONT COLOR="#9ca3af" POINT-SIZE="8">  → users.id</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="updated_at_in"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR></TABLE>>];
        "ingestion_batches" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#166534" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#166534" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>ingestion_batches</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="id_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="uid_in"><FONT COLOR="#6b7280" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">uid</TD><TD ALIGN="LEFT" PORT="uid_out"><FONT COLOR="#6b7280" POINT-SIZE="9">char</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="project_id_in"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT" PORT="project_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="api_key_id_in"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">api_key_id</TD><TD ALIGN="LEFT" PORT="api_key_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="count_in"></TD><TD ALIGN="LEFT">count</TD><TD ALIGN="LEFT" PORT="count_out"><FONT COLOR="#6b7280" POINT-SIZE="9">int</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="accepted_count_in"></TD><TD ALIGN="LEFT">accepted_count</TD><TD ALIGN="LEFT" PORT="accepted_count_out"><FONT COLOR="#6b7280" POINT-SIZE="9">int</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="duplicate_count_in"></TD><TD ALIGN="LEFT">duplicate_count</TD><TD ALIGN="LEFT" PORT="duplicate_count_out"><FONT COLOR="#6b7280" POINT-SIZE="9">int</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="rejected_count_in"></TD><TD ALIGN="LEFT">rejected_count</TD><TD ALIGN="LEFT" PORT="rejected_count_out"><FONT COLOR="#6b7280" POINT-SIZE="9">int</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="status_in"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT" PORT="status_out"><FONT COLOR="#6b7280" POINT-SIZE="9">enum</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="errors_in"></TD><TD ALIGN="LEFT">errors</TD><TD ALIGN="LEFT" PORT="errors_out"><FONT COLOR="#6b7280" POINT-SIZE="9">json</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="processed_at_in"></TD><TD ALIGN="LEFT">processed_at</TD><TD ALIGN="LEFT" PORT="processed_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="updated_at_in"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR></TABLE>>];
        "ingestion_keys" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#166534" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#166534" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>ingestion_keys</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="id_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="project_id_in"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT" PORT="project_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="external_id_in"><FONT COLOR="#6b7280" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">external_id</TD><TD ALIGN="LEFT" PORT="external_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="log_uid_in"></TD><TD ALIGN="LEFT">log_uid</TD><TD ALIGN="LEFT" PORT="log_uid_out"><FONT COLOR="#6b7280" POINT-SIZE="9">char</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="occurred_at_in"></TD><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT" PORT="occurred_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">datetime</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">datetime</FONT></TD></TR></TABLE>>];
        "audit_logs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#166534" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#166534" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>audit_logs</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="id_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="uid_in"></TD><TD ALIGN="LEFT">uid</TD><TD ALIGN="LEFT" PORT="uid_out"><FONT COLOR="#6b7280" POINT-SIZE="9">char</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="project_id_in"></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT" PORT="project_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="api_key_id_in"></TD><TD ALIGN="LEFT">api_key_id</TD><TD ALIGN="LEFT" PORT="api_key_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="batch_id_in"></TD><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT" PORT="batch_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="external_id_in"></TD><TD ALIGN="LEFT">external_id</TD><TD ALIGN="LEFT" PORT="external_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="event_in"></TD><TD ALIGN="LEFT">event</TD><TD ALIGN="LEFT" PORT="event_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="action_in"></TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT" PORT="action_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="severity_in"></TD><TD ALIGN="LEFT">severity</TD><TD ALIGN="LEFT" PORT="severity_out"><FONT COLOR="#6b7280" POINT-SIZE="9">enum</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="actor_type_in"></TD><TD ALIGN="LEFT">actor_type</TD><TD ALIGN="LEFT" PORT="actor_type_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="actor_id_in"></TD><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT" PORT="actor_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="actor_name_in"></TD><TD ALIGN="LEFT">actor_name</TD><TD ALIGN="LEFT" PORT="actor_name_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="actor_ip_in"></TD><TD ALIGN="LEFT">actor_ip</TD><TD ALIGN="LEFT" PORT="actor_ip_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="user_agent_in"></TD><TD ALIGN="LEFT">user_agent</TD><TD ALIGN="LEFT" PORT="user_agent_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="subject_type_in"></TD><TD ALIGN="LEFT">subject_type</TD><TD ALIGN="LEFT" PORT="subject_type_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="subject_id_in"></TD><TD ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT" PORT="subject_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="old_values_in"></TD><TD ALIGN="LEFT">old_values</TD><TD ALIGN="LEFT" PORT="old_values_out"><FONT COLOR="#6b7280" POINT-SIZE="9">json</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="new_values_in"></TD><TD ALIGN="LEFT">new_values</TD><TD ALIGN="LEFT" PORT="new_values_out"><FONT COLOR="#6b7280" POINT-SIZE="9">json</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="metadata_in"></TD><TD ALIGN="LEFT">metadata</TD><TD ALIGN="LEFT" PORT="metadata_out"><FONT COLOR="#6b7280" POINT-SIZE="9">json</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="tags_in"></TD><TD ALIGN="LEFT">tags</TD><TD ALIGN="LEFT" PORT="tags_out"><FONT COLOR="#6b7280" POINT-SIZE="9">json</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="request_id_in"></TD><TD ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT" PORT="request_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="correlation_id_in"></TD><TD ALIGN="LEFT">correlation_id</TD><TD ALIGN="LEFT" PORT="correlation_id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="occurred_at_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>occurred_at</B></TD><TD ALIGN="LEFT" PORT="occurred_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">datetime</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="received_at_in"></TD><TD ALIGN="LEFT">received_at</TD><TD ALIGN="LEFT" PORT="received_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">datetime</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">datetime</FONT></TD></TR></TABLE>>];
    }
    subgraph cluster_access {
        label=<<B>Users and permissions  ·  المستخدمون والصلاحيات</B>>; fontsize=15; fontcolor="#1e40af"; style="rounded,filled"; color="#1e40af"; fillcolor="#eff6ff"; penwidth=1.5; margin=18;
        "users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1e40af" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1e40af" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>users</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="id_in"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#6b7280" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="name_in"></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="email_in"><FONT COLOR="#6b7280" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="email_verified_at_in"></TD><TD ALIGN="LEFT">email_verified_at</TD><TD ALIGN="LEFT" PORT="email_verified_at_out"><FONT COLOR="#6b7280" POINT-SIZE="9">timestamp</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="password_in"></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT" PORT="password_out"><FONT COLOR="#6b7280" POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="is_active_in"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active_out"><FONT COLOR="#6b7280" POINT-SIZE="9">tinyint</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="app_authentication_secret_in"></TD><TD ALIGN="LEFT">app_authentication_secret</TD><TD ALIGN="LEFT" PORT="app_authentication_secret_out"><FONT COLOR="#6b7280" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" PORT="app_authentication_recovery_codes_in"></TD><TD ALIGN="LEFT">app_authentication_recovery_codes</TD><TD ALIGN="LEFT" PORT="app_authentication_recovery_codes_out"><FONT COLOR="#6b7280" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="26" 