#!/usr/bin/env bash
# First-time setup (and safe to re-run):
#   1. .env from .env.docker.example with random secrets
#   2. images built, PHP dependencies installed (new packages added to
#      composer.json are installed without upgrading the locked ones)
#   3. backup encryption key pair (age) generated
#   4. stack started, app key generated, migrations + seeders run
#
#   ./bin/setup
set -euo pipefail
cd "$(dirname "$0")/.."

say() { printf '\n\033[1;32m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*"; }

command -v docker >/dev/null 2>&1 || { echo "Docker is required (Docker Desktop on macOS)." >&2; exit 1; }
docker compose version >/dev/null 2>&1 || { echo "Docker Compose v2 is required." >&2; exit 1; }

set_env() { # set_env KEY VALUE  (replaces the line in .env)
    local key="$1" value="$2" tmp
    tmp="$(mktemp)"
    awk -v k="$key" -v v="$value" 'BEGIN{done=0} $0 ~ "^"k"=" {print k"="v; done=1; next} {print} END{if(!done) print k"="v}' .env > "$tmp"
    cat "$tmp" > .env && rm -f "$tmp"
}

if [ ! -f .env ]; then
    say "Creating .env with random secrets"
    cp .env.docker.example .env
    for key in DB_PASSWORD DB_MAINTENANCE_PASSWORD DB_ROOT_PASSWORD DB_ARCHIVER_PASSWORD DB_BACKUP_PASSWORD; do
        if grep -qE "^${key}=change-me" .env; then
            set_env "$key" "$(openssl rand -hex 24)"
        fi
    done
fi

# Settings added to .env.docker.example after this .env was created are
# appended (secrets randomised), so an older .env keeps working.
added=""
while IFS= read -r line; do
    key="${line%%=*}"
    [[ "$line" =~ ^[A-Z0-9_]+= ]] || continue
    grep -qE "^${key}=" .env && continue
    value="${line#*=}"
    [[ "$value" == change-me* ]] && value="$(openssl rand -hex 24)"
    printf '%s=%s\n' "$key" "$value" >> .env
    added="$added $key"
done < .env.docker.example
[ -n "$added" ] && echo "Added to .env:$added"

# The development MinIO service was removed (MinIO no longer publishes its
# images): an .env still pointing at it is switched to local storage.
if grep -qE '^AWS_ENDPOINT=http://minio:9000' .env; then
    set_env AUDIT_ARCHIVE_DRIVER local
    set_env BACKUP_DRIVER local
    set_env BACKUP_RCLONE_REMOTE ""
    set_env AWS_ENDPOINT ""
    set_env AWS_ACCESS_KEY_ID ""
    set_env AWS_SECRET_ACCESS_KEY ""
    set_env AWS_USE_PATH_STYLE_ENDPOINT false
    set_env BACKUP_S3_PROVIDER AWS
    echo "Switched archive and backups to local storage (MinIO removed from development)."
fi

if grep -qE '^ADMIN_EMAIL=$' .env; then
    warn "Tip: set ADMIN_EMAIL and ADMIN_PASSWORD in .env to create the first Super Admin (then run: make seed)."
fi

say "Building images"
docker compose build

composer_run() { docker compose run --rm --no-deps -T --entrypoint composer app "$@"; }

say "Installing PHP dependencies (the first run takes a few minutes)"
if [ ! -f composer.lock ]; then
    composer_run update --no-interaction --prefer-dist
else
    # Packages declared in composer.json but missing from composer.lock are
    # installed with their dependencies; everything else stays as locked.
    missing="$(docker compose run --rm --no-deps -T --entrypoint php app -r '
        $json = json_decode(file_get_contents("composer.json"), true);
        $lock = json_decode(file_get_contents("composer.lock"), true);
        $locked = array_column(array_merge($lock["packages"] ?? [], $lock["packages-dev"] ?? []), "name");
        $wanted = array_keys(array_merge($json["require"] ?? [], $json["require-dev"] ?? []));
        $wanted = array_filter($wanted, fn ($p) => str_contains($p, "/"));
        echo implode(" ", array_diff($wanted, $locked));
    ')"
    if [ -n "$missing" ]; then
        echo "New packages: $missing"
        # shellcheck disable=SC2086
        composer_run update $missing --with-all-dependencies --no-interaction --prefer-dist
    else
        composer_run install --no-interaction --prefer-dist
    fi
fi

if grep -qE '^BACKUP_AGE_RECIPIENT=$' .env; then
    say "Generating the backup encryption key (age)"
    mkdir -p secrets && chmod 700 secrets
    if [ ! -f secrets/backup-age-identity.txt ]; then
        docker compose run --rm --no-deps -T --entrypoint age-keygen app > secrets/backup-age-identity.txt
        chmod 600 secrets/backup-age-identity.txt
    fi
    recipient="$(grep -E '^# public key: ' secrets/backup-age-identity.txt | sed 's/^# public key: //')"
    set_env BACKUP_AGE_RECIPIENT "$recipient"
    warn "The PRIVATE backup key is in secrets/backup-age-identity.txt."
    warn "Store it OFF this server (password manager / vault): without it backups cannot be restored."
fi

say "Starting the stack"
mkdir -p storage/app/backup-spool storage/telescope
docker compose up -d
wait_healthy() { # wait_healthy SERVICE
    local id status
    for _ in $(seq 1 90); do
        id="$(docker compose ps -q "$1")"
        status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id" 2>/dev/null || echo starting)"
        [ "$status" = healthy ] && return 0
        sleep 4
    done
    echo "$1 did not become healthy - check: docker compose logs $1" >&2
    return 1
}
for svc in mariadb redis app; do wait_healthy "$svc"; done

if ! grep -qE '^APP_KEY=.+' .env; then
    say "Generating the application key"
    docker compose exec -T app php artisan key:generate --force
fi

say "Migrating and seeding"
docker compose exec -T app php artisan migrate --seed --force
docker compose exec -T app php artisan audit:partitions

if grep -qE '^APP_ENV=local' .env && [ -d vendor/laravel/telescope ]; then
    touch storage/telescope/telescope.sqlite
    docker compose exec -T app php artisan migrate --database=telescope \
        --path=vendor/laravel/telescope/database/migrations --realpath --force >/dev/null
fi

port="$(grep -E '^APP_PORT=' .env | cut -d= -f2)"
say "Done"
cat <<EOF
  Dashboard : http://localhost:${port:-8080}/admin
  API       : http://localhost:${port:-8080}/api/v1  (docs: /docs/api)
  Horizon   : http://localhost:${port:-8080}/horizon

  Run the checks : ./bin/doctor     Run the tests : make test
EOF
